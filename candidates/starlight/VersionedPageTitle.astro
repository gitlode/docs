---
import PageTitle from "@astrojs/starlight/components/PageTitle.astro";

import site from "../site.json";

// Use the requested URL, not the English entry ID of a Japanese fallback page.
const relative = Astro.url.pathname.startsWith(site.base)
  ? Astro.url.pathname.slice(site.base.length)
  : "";
const locale = relative.split("/")[0];
const label = locale === "ja" ? "バージョン" : "Version";
const candidateBase = site.base.replace(/(?:stable|next)\/$/, "");
---

{
  site.combined && ["en", "ja"].includes(locale) && (
    <nav class="version-switch" data-version-navigation aria-label={label} lang={locale}>
      <span>{label}:</span>
      {["stable", "next"].map((edition) =>
        edition === site.edition ? (
          <strong aria-current="page">{edition}</strong>
        ) : (
          <a href={`${candidateBase}${edition}/${relative}`} target="_self" data-astro-reload>
            {edition}
          </a>
        ),
      )}
    </nav>
  )
}
<PageTitle />

<style>
  .version-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: baseline;
    margin-bottom: 1rem;
    font-size: var(--sl-text-sm);
  }
  a {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
