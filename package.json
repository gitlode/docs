{
  "name": "@gitlode/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Selective, versioned documentation publishing for gitlode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitlode/docs.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p site/vitepress/tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "format": "node -e \"console.error('Error: Please run format:check or format:write instead.'); process.exit(1)\"",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint src test site",
    "lint:fix": "oxlint --fix src test site",
    "lockfile:sync": "npm install --package-lock-only --ignore-scripts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "source:acquire": "node --experimental-strip-types src/publishing/cli.ts acquire",
    "content:stage": "node --experimental-strip-types src/publishing/cli.ts stage",
    "translations:prepare-stable": "node --experimental-strip-types src/publishing/cli.ts prepare-stable-translations",
    "search:verify": "node --experimental-strip-types src/ssg/vitepress/search.ts",
    "site:prepare": "node --experimental-strip-types src/cli/site.ts prepare",
    "site:build": "node --experimental-strip-types src/cli/site.ts build",
    "site:verify": "node --experimental-strip-types src/cli/site.ts verify",
    "preview": "node --experimental-strip-types src/cli/site.ts preview"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.77.0",
    "parse5": "7.3.0",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1",
    "sirv": "3.0.2",
    "typescript": "5.9.3",
    "unist-util-visit": "5.2.0",
    "vitepress": "2.0.0-alpha.21",
    "vue": "3.5.45",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.23.4 <23",
    "npm": ">=11 <12"
  }
}
